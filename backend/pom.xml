<?xml version="1.0" encoding="UTF-8"?>
<!-- backend（Spring Boot）のビルド設定。使用する依存ライブラリ（下のdependencies）とJavaバージョンをここで管理する -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<!-- pom.xml自体の書式バージョン。Maven4系では現時点でもこの値を使う（固定値） -->
	<modelVersion>4.0.0</modelVersion>
	<!-- Spring Boot公式の親POM。下のdependenciesで<version>を省略できる（親が適切なバージョンを決めてくれる）のはこのため -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<!-- このプロジェクト自身を一意に識別するための情報（groupId+artifactId+versionの組み合わせ） -->
	<groupId>com.example</groupId>
	<artifactId>backend</artifactId>
	<!-- SNAPSHOT＝開発中・未リリースのバージョンであることを示す接尾辞 -->
	<version>0.0.1-SNAPSHOT</version>
	<name>backend</name>
	<description>Event Application System Backend API</description>
	<url/>
	<!-- licenses/developers/scmはSpring Initializrが生成した雛形のままで、このプロジェクトでは未設定（空）の項目 -->
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<!-- コンパイル・実行に使うJavaのバージョン -->
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<!-- B-3: REST API（Controller）を作るための土台。埋め込みTomcatも含む -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- B-4: DBのテーブルをJavaのクラスとして扱う仕組み（JPA/Hibernate）＋Repositoryパターンの土台 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- B-4: MySQLに接続するためのドライバ本体。実行時のみ必要なのでruntimeスコープ -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- B-5: @Valid等によるBean Validation（入力チェック）の土台 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- D-15: 実装から自動生成されるAPI仕様（Swagger UI／OpenAPI JSON） -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.8.9</version>
		</dependency>

		<!-- ここから下はtestスコープ＝本番の実行には含まれず、テストコードのビルド・実行時のみ使う -->
		<!-- JUnit5・Mockito・MockMvc・AssertJなど、Spring Bootのテストで使う定番ライブラリ一式 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- G-2: TestRestTemplate（結合テストで実際にHTTPを叩く）が内部で使うRestTemplateBuilderのため必要 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-restclient</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- @DataJpaTest等、JPA（DBアクセス）周りだけをテストするための補助ライブラリ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- D-1: テスト実行時はMySQLの代わりにこのインメモリDBを使う（実MySQLが無くてもmvn testが通るように） -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- mvn spring-boot:run での起動や、依存ライブラリを全て含んだ実行可能jar（java -jarで動かせる形式）への
			     パッケージ化を可能にするプラグイン -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
